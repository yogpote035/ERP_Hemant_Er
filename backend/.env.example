# Copy to .env (optional — sensible defaults are baked in).
PORT=4000
NODE_ENV=development
# REQUIRED in production — the server refuses to start in prod with the dev default.
JWT_SECRET=dev-secret-change-me
JWT_EXPIRES_IN=12h

# Persistence: set DATABASE_URL to use Postgres (production). `docker compose up -d`
# starts one on :5433. Leave DATABASE_URL unset to use the JSON-file dev store.
DATABASE_URL=postgres://hew:hew@localhost:5433/hew_erp
DATA_FILE=./data/db.json

CORS_ORIGIN=http://localhost:5173,http://localhost:5174

# Seeding (first boot, empty DB only):
#  - dev default: loads the full demo dataset incl. `demo`-password accounts.
#  - production: demo is OFF — set SEED_ADMIN_EMAIL + a strong SEED_ADMIN_PASSWORD
#    to create the initial admin (no demo data). SEED_DEMO=true forces demo on (never in prod).
# SEED_DEMO=false
SEED_ADMIN_EMAIL=
SEED_ADMIN_PASSWORD=
