{
  "name": "hew-erp-backend",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "description": "Job Work Management & Billing ERP — REST API for Hemant Engineering Works",
  "scripts": {
    "dev": "node --env-file=.env --import tsx --watch src/server.ts",
    "start": "node dist/server.js",
    "build": "tsc -p tsconfig.json",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "seed": "tsx src/db/seed.ts",
    "seed:parts": "node --env-file=.env --import tsx scripts/seedParts.ts",
    "remove:demo": "node --env-file=.env --import tsx scripts/removeDemoData.ts",
    "clear:keep-roles": "node --env-file=.env --import tsx scripts/clearAllExceptRoles.ts",
    "create-admin": "node --env-file=.env --import tsx scripts/createAdmin.ts",
    "set-password": "node --env-file=.env --import tsx scripts/setPassword.ts",
    "smoke": "node scripts/smoke.mjs",
    "test": "tsx --test test/domain.test.ts test/api.test.ts",
    "test:pg": "tsx --test test/pg.test.ts"
  },
  "dependencies": {
    "@types/bcryptjs": "^2.4.6",
    "@types/cors": "^2.8.17",
    "@types/express": "^4.17.21",
    "@types/jsonwebtoken": "^9.0.6",
    "@types/node": "^22.7.4",
    "bcryptjs": "^2.4.3",
    "cors": "^2.8.5",
    "express": "^4.19.2",
    "express-rate-limit": "^8.5.2",
    "helmet": "^8.2.0",
    "jsonwebtoken": "^9.0.2",
    "mysql2": "^3.14.5",
    "typescript": "^5.6.2",
    "zod": "^3.23.8"
  },
  "devDependencies": {
    "@types/supertest": "^6.0.2",
    "supertest": "^7.0.0",
    "tsx": "^4.19.1"
  }
}
