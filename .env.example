# Copy to .env in the project root and fill in before production start.
# Generate strong secrets with:  openssl rand -hex 32

# Node API + React static server
NODE_ENV=production
PORT=4000
DATABASE_URL=postgres://hew:change-me@localhost:5432/hew_erp
JWT_SECRET=change-me-to-a-32-char-or-longer-random-secret
JWT_EXPIRES_IN=12h
CORS_ORIGIN=http://localhost:4000

# First-run admin — used ONCE to create the initial admin on an EMPTY database.
# After first boot, rotate/add users in-app or run:
#   cd backend && npm run set-password -- <email> <password>
SEED_ADMIN_EMAIL=admin@yourcompany.com
SEED_ADMIN_PASSWORD=change-me-strong-admin-password
